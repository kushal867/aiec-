ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
DATABASE_PATH=./data/knowledge.db
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
ADMIN_ALLOWED_ORIGIN=http://localhost:3002
TOP_K=5
SIMILARITY_THRESHOLD=0.5
RATE_LIMIT_MAX=20
PROFILE_RATE_LIMIT_MAX=5
DOCUMENT_RATE_LIMIT_MAX=8
UPLOADS_DIR=./data/uploads

# Optional — auto-generated and persisted to data/.jwt-secret if unset (fine
# for local dev). Set explicitly in any real deployment so a redeploy doesn't
# invalidate every login session.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Optional — only read by `npm run seed-users`, to choose initial passwords
# instead of randomly generating them.
ADMIN_PASSWORD=
COUNSELLOR_PASSWORD=
