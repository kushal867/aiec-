EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATABASE_PATH=./data/knowledge.db
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
ADMIN_ALLOWED_ORIGIN=http://localhost:3002
TOP_K=5
SIMILARITY_THRESHOLD=0.5
RATE_LIMIT_MAX=20
PROFILE_RATE_LIMIT_MAX=5
DOCUMENT_RATE_LIMIT_MAX=8
UPLOADS_DIR=./data/uploads

# Self-training conversion model (see services/conversion_model.py) — below
# this many real terminal-outcome leads (enrolled/rejected), predictions fall
# back to the rule-based rubric in conversion_prediction.py.
CONVERSION_MODEL_MIN_TRAINING_ROWS=30
CONVERSION_MODEL_PATH=./data/conversion_model.joblib

# Optional — auto-generated and persisted to data/.jwt-secret if unset (fine
# for local dev). Set explicitly in any real deployment so a redeploy doesn't
# invalidate every login session.
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12

# Optional — only read by scripts/seed_users.py, to choose initial passwords
# instead of randomly generating them.
ADMIN_PASSWORD=
COUNSELLOR_PASSWORD=
ADMIN_EMAIL=
COUNSELLOR_EMAIL=
